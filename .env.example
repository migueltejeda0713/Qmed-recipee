# ─── Base de datos ────────────────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=qmed_recipe
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_SSL_MODE=required

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ─── Protección de login ──────────────────────────────────────────────────────
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
REFRESH_GRACE_SECONDS=2

# ─── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5174

# ─── Proxies de confianza ─────────────────────────────────────────────────────
# Dejar vacío si no hay proxy inverso.
# Con nginx local: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=
